---
import Base from '../layouts/Base.astro';
import qr from '../qr.png';
import '../chat.css';
---
<Base frontmatter={{ title: 'chat | kyotana', nerdfont: true }}>
  <div class="chat">
    <div class="log">
      <div class="msg user">
        <p>Magochiの得意料理はなんですか。</p>
      </div>
      <div class="msg assistant">
        <p>麻婆豆腐です。</p>
      </div>
      <div class="msg user">
        <p>この作品についての QR コードを生成してください。</p>
      </div>
      <div class="msg assistant">
        <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
        <div class="reply">
          <p>承知しました。こちらが本作品の QR コードです。</p>
          <img src={qr.src} width={qr.width} height={qr.height} alt="本作品の QR コード">
        </div>
      </div>
    </div>

    <div class="composer">
      <textarea rows="1" placeholder="メッセージを入力" aria-label="メッセージ" disabled></textarea>
      <button type="button" aria-label="送信" disabled>↑</button>
    </div>
  </div>
</Base>
